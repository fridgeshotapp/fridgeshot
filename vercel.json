{
  "functions": {
    "api/analyze.js": { "maxDuration": 30 },
    "api/recipes.js": { "maxDuration": 30 },
    "api/chat.js": { "maxDuration": 30 },
    "api/stripe/webhook.js": { "maxDuration": 15 }
  },
  "rewrites": [
    { "source": "/app", "destination": "/app.html" },
    { "source": "/privacidad", "destination": "/privacidad.html" },
    { "source": "/terminos", "destination": "/terminos.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
